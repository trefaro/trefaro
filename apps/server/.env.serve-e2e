# The rate-limit profile of the end-to-end runs (E61).
#
# Nx loads this file for the task `server:serve-e2e` and for no other — not for
# `nx serve server`, not for a build, and least of all for the container image,
# which contains no Nx, no project.json and no copy of this file. That is the
# whole point: a test profile must never be what an instance ships, so it lives
# somewhere the production stack cannot reach, and the server names it in the
# startup log the moment it reads it.
#
# Why it exists: three e2e projects share one server process in a full run
# (measured in AP 8 of phase 4), so their registrations, logins and newsletter
# sign-ups land in one set of counters. With the shipped numbers the suite that
# ran last got 429 where it expected 202, and the failure looked like a broken
# endpoint. The remedy is never to loosen a limit in the code (E4) — it is to
# let the test environment configure its own budget, which is what this is.
RATE_LIMIT_PROFILE=e2e

LOGIN_ATTEMPTS_PER_WINDOW=300
REGISTRATIONS_PER_WINDOW=400
NEWSLETTER_SIGNUPS_PER_WINDOW=200
CONFIRMATIONS_PER_WINDOW=400

# The reset link of AP 4: raised for the same reason as the four above, and it
# is the one that would have bitten first. A full run asks for around twenty
# links in five minutes — nine in the contract suite, six of them in the test
# that measures whether a known address takes longer than an unknown one, and
# one per browser engine — against a shipped budget of twenty.
PASSWORD_RESETS_PER_WINDOW=200

# Deliberately NOT raised, and deliberately written out rather than omitted: the
# recipient counter is new in phase 5, no suite has grown around it, and leaving
# it at the shipped value means every full run exercises the real number. A
# limit that is raised everywhere is a limit nobody is testing (E4) — this is
# the one that stays honest.
MAILS_PER_RECIPIENT_PER_WINDOW=5

# The pause between two invitations, shortened from the shipped second (E62,
# AP 3). Two hundred invitations are part of the contract suite, and at the
# default they would take three and a half minutes of a run that has nothing to
# learn from the last three of them. Shortened, not switched off: the suite
# asserts that the send takes *minutes* rather than seconds, so the pause is
# still the thing under test — and the server says out loud at startup that
# this number is below the default, in the same breath as the profile.
SMTP_PAUSE_BETWEEN_MAILS_MS=150
