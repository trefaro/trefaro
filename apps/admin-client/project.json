{
  "name": "admin-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "trefaro",
  "sourceRoot": "apps/admin-client/src",
  "tags": ["scope:admin-client", "type:app"],
  "// build": "`optimization.styles.inlineCritical` is off on purpose (AP 9 of phase 5). With it on, Angular defers the stylesheet as `<link rel=\"stylesheet\" media=\"print\" onload=\"this.media='all'\">` \u2014 and the content security policy the proxy sets refuses an inline event handler, so the handler never runs, the sheet stays `media=print`, and the page renders with the inlined fragment alone. Found by `apps/stack-e2e/src/security-headers.spec.ts`, which opens both clients and reads the console. The policy is not the thing to loosen: `'unsafe-hashes'` plus the hash of `this.media='all'` would buy a few milliseconds of first paint on an application whose first paint waits for `/api/config` anyway.",
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/admin-client",
        "browser": "apps/admin-client/src/main.ts",
        "tsConfig": "apps/admin-client/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/admin-client/public"
          }
        ],
        "styles": [
          "libs/shared-theming/assets/fonts.css",
          "apps/admin-client/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4300,
        "proxyConfig": "apps/admin-client/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "admin-client:build:production"
        },
        "development": {
          "buildTarget": "admin-client:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin-client:build",
        "port": 4300,
        "staticFilePath": "dist/apps/admin-client/browser",
        "spa": true
      }
    }
  }
}
