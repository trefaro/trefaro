# Dependencies
node_modules/

# Build outputs
dist/
tmp/
out-tsc/
.angular/

# Nx
.nx/cache
.nx/workspace-data

# Environment / secrets
.env
.env.*
!.env.example
# Checked in on purpose: the end-to-end rate-limit profile holds no secret, and
# a file the production stack does not know is exactly what E61 asks a test
# profile to be. Nx loads it for the `serve-e2e` task alone.
!apps/server/.env.serve-e2e

# Test artifacts
coverage/
playwright-report/
test-results/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

.angular

__screenshots__/

# Thesis full text — the diagrams and mockups in docs/thesis/ are the reference
# the implementation needs; the complete document stays out of the public repo.
docs/thesis/*.pdf

# Playwright MCP writes snapshots and screenshots here while a session drives a browser.
.playwright-mcp/
