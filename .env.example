# Trefaro — instance configuration.
#
#   cp .env.example .env
#
# Every value the server needs is declared in
# apps/server/src/app/core/config/env.ts and validated on startup: a
# misconfigured instance refuses to start and prints every problem at once,
# rather than failing on some later request.
#
# The defaults below are development defaults. In production the server insists
# on the values marked "required in production".

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# Named SERVER_PORT rather than PORT: Vite — and so the Angular dev server —
# reads PORT as well, and a shared PORT would move a client onto this port.
SERVER_PORT=3000

# Public origins of both clients. Used for the CORS allow-list, for the
# WebSocket allow-list, and as the link base in outgoing e-mail — so a
# confirmation link in a double opt-in mail points at the right host.
PUBLIC_USER_CLIENT_URL=http://localhost:4200
PUBLIC_ADMIN_CLIENT_URL=http://localhost:4300

# Signs authentication tokens and double opt-in confirmation links.
# Required in production, minimum 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Administrative access (FR 1.2, FR 1.3)
# ---------------------------------------------------------------------------
# The first administrator, created only while no administrator exists at all.
# Remove both values once you have created a personal account.
# For local development set them: the API contract suite logs in with this pair.
# In the container stack these two decide whether anyone can get in at all —
# every route that could create an administrator requires a session.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# How long an administrative session survives without being used.
ADMIN_SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trefaro
DATABASE_USER=trefaro
# Required in production.
DATABASE_PASSWORD=trefaro_dev
DATABASE_SSL=false

# TypeORM schema auto-sync. Migrations are the only authority over the schema,
# so this must stay off — the server refuses to start with it on in production.
DATABASE_SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# E-mail — the organization's own SMTP server, never a third-party service
# ---------------------------------------------------------------------------
# Defaults point at the Mailpit container from docker-compose.dev.yml, which
# catches every mail and shows it at http://localhost:8025.
# SMTP_HOST and SMTP_FROM are required when NODE_ENV=production: double opt-in is
# the only way to become a participant, so an instance that cannot send mail
# cannot collect registrations — better to fail at startup than at the first one.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Trefaro <no-reply@localhost>

# ---------------------------------------------------------------------------
# Web Push (self-hosted, VAPID) — no Firebase, no third-party push service
# ---------------------------------------------------------------------------
# Optional: leave both keys empty and the instance runs without push. Generate a
# pair with:
#   npx web-push generate-vapid-keys
# The private key must never reach a client; the server publishes only the
# public one through /api/config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address for the push service, as mailto: or https URL.
VAPID_SUBJECT=mailto:admin@example.org

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Logos, avatars, chat images and registration attachments.
UPLOAD_DIR=./tmp/uploads

# Web component bundles of the curated plug-ins, served under /api/plugins.
# Built by `nx build plugin-room-planning`.
PLUGIN_BUNDLE_DIR=./dist/apps/plugins

# ---------------------------------------------------------------------------
# Production stack only (infra/docker-compose.yml)
# ---------------------------------------------------------------------------
# Host port the reverse proxy publishes.
HTTP_PORT=8080
